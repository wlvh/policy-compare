# Offline AXA OpenShift packaging. Prebuild MuPDF + Rust/WASM from the exact source revision.
# This image only packages bytes from prebuilt/mupdf/ and requires no Rust, npm or pnpm access.
ARG NODE_IMAGE=artifactory.platform.axaxl-cloud.com/docker/library/node:24
FROM ${NODE_IMAGE}
WORKDIR /app
COPY prebuilt/mupdf/ ./dist/
COPY deploy/server.mjs ./server.mjs
COPY deploy/harness/verify-prebuilt.mjs ./verify-prebuilt.mjs
RUN node ./verify-prebuilt.mjs ./dist && rm ./verify-prebuilt.mjs && chmod -R a=rX /app
ENV HOST=0.0.0.0 PORT=8080 STATIC_ROOT=/app/dist NODE_ENV=production
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.mjs"]
